:root{--blue:#0C00FF;--lime:#CBF450;--soft:#E2E0FF;--mist:#EAF1FD;--ink:#0A0A0F;--grey:#5B5F73;--white:#fff;--font:'Google Sans','Product Sans',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;color-scheme:light}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:var(--font);background:var(--white);color:var(--ink);font-size:18px;line-height:1.45;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
.hero{background:var(--blue);color:var(--white)}
.hero-in{max-width:900px;margin:0 auto;padding:26px 20px 30px;display:flex;align-items:flex-start;justify-content:space-between;gap:16px}
.logo{height:26px;width:auto;margin-bottom:18px}
.badges{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}
.badge{font-size:14px;font-weight:500;padding:6px 14px;border-radius:999px;line-height:1.2;background:var(--white);color:var(--blue)}
.badge.lime{background:var(--lime)}
h1{margin:0;font-size:clamp(32px,7vw,56px);line-height:1.08;font-weight:700;letter-spacing:-0.02em;text-wrap:balance}
.arrow{width:clamp(72px,16vw,132px);height:auto;flex:none}
main{max-width:900px;margin:0 auto;padding:24px 20px 56px}
.back{display:inline-flex;align-items:center;gap:6px;margin-bottom:16px;color:var(--blue);font-weight:500;font-size:16px;text-decoration:none}
.back:hover{text-decoration:underline;text-underline-offset:3px}
.back svg{width:18px;height:18px}
.lead{margin:0 0 20px;color:var(--grey);max-width:60ch}
.list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.card{display:flex;gap:14px;align-items:flex-start;text-decoration:none;background:var(--soft);border:2px solid transparent;border-radius:24px;padding:18px;transition:transform .15s,border-color .15s}
.card:hover{border-color:var(--blue);transform:translateY(-2px)}
.num{width:36px;height:36px;border-radius:50%;background:var(--blue);color:var(--white);font-weight:600;font-size:17px;display:inline-flex;align-items:center;justify-content:center;flex:none}
.card h2{margin:2px 0 4px;font-size:21px;font-weight:600;line-height:1.2}
.card p{margin:0;color:var(--grey);font-size:16px;line-height:1.35}
.pill{display:inline-block;margin-top:8px;font-size:14px;font-weight:500;background:var(--white);color:var(--blue);padding:3px 10px;border-radius:999px}
.empty{background:var(--mist);border-radius:24px;padding:22px;color:var(--grey)}
@media (max-width:520px){body{font-size:17px}.list{grid-template-columns:1fr}.hero-in{padding:20px 16px 24px}main{padding:20px 16px 48px}}
@media (prefers-reduced-motion:reduce){.card{transition:none}}
